generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                 @id @default(uuid())
  name                  String?
  email                 String                 @unique
  role                  String                 @default("CLIENTE")
  createdAt             DateTime               @default(now())
  countryCode           String?
  suiteNo               String?                @unique
  dateOfBirth           DateTime?
  address               String?
  cityZip               String?
  country               String?
  phone                 String?
  referralCode          String?                @unique
  referredBy            String?
  shippingBalance       Float                  @default(0.0)
  stripeCustomerId      String?                @unique
  image                 String?
  password              String?
  referralRewardPaid    Boolean                @default(false)
  resetToken            String?                @unique
  resetTokenExpiry      DateTime?
  walletBalance         Float                  @default(0.0)
  emailVerified         DateTime?
  planType              String?                @default("STANDARD")
  noConsolidationFee    Boolean                @default(false)
  tenant_id             String?
  lastLoginAt           DateTime?
  stripeAccountId       String?                @unique
  smsConsent            Boolean                @default(false)
  preferredLocale       String                 @default("en")
  addresses             Address[]
  b2bAccount            B2BAccount?
  consolidatedShipments ConsolidatedShipment[]
  mailItems             MailItem[]
  mailPickupRequests    MailPickupRequest[]
  mailboxSubscription   MailboxSubscription?
  mailboxTransactions   MailboxTransaction[]
  notifications         Notification[]
  packages              Package[]
  paymentMethods        PaymentMethod[]
  assignedTasks         PickupRequest[]        @relation("DriverAssignments")
  pickupRequests        PickupRequest[]
  shopperOrders         ShopperOrder[]
  tenant                Tenant?                @relation(fields: [tenant_id], references: [id])
  driverSession         DriverSession?         @relation("DriverSession")
  driverVehicles        DriverVehicle[]        @relation("DriverVehicle")
}

model PaymentMethod {
  id                    String   @id @default(uuid())
  createdAt             DateTime @default(now())
  stripePaymentMethodId String   @unique
  brand                 String
  last4                 String
  expMonth              Int
  expYear               Int
  isDefault             Boolean  @default(false)
  isBackup              Boolean  @default(false)
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Package {
  id                     String                @id @default(uuid())
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  status                 String
  description            String?
  storagePaidUntil       DateTime?
  storageDebt            Float                 @default(0.0)
  courier                String?
  declaredValue          Float?                @default(0.0)
  weightLbs              Float?
  lengthIn               Float?
  widthIn                Float?
  heightIn               Float?
  photoUrlMiami          String?
  receiptUrl             String?
  invoiceUrl             String?
  carrierTrackingNumber  String?
  gmcTrackingNumber      String                @unique
  estimatedArrival       DateTime?
  userId                 String
  consolidatedShipmentId String?
  courierService         String?
  customsItems           Json?
  deliveredBy            String?
  deliveryPhotoUrl       String?
  deliverySignature      String?
  finalTrackingNumber    String?
  selectedCourier        String?
  shippingAddress        String?
  shippingLabelUrl       String?
  shippingProcessingFee  Float?                @default(0.0)
  shippingSubtotal       Float?                @default(0.0)
  shippingTotalPaid      Float?                @default(0.0)
  stripePaymentId        String?
  tookanLink             String?
  serviceType            String?               @default("SHIPPING_INTL")
  awbDocumentUrl         String?
  extraCharges           Json?
  tenant_id              String?
  easypostRateId         String?
  easypostShipmentId     String?
  easypostTrackerId      String?
  consolidatedShipment   ConsolidatedShipment? @relation(fields: [consolidatedShipmentId], references: [id])
  tenant                 Tenant?               @relation(fields: [tenant_id], references: [id])
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gmcTrackingNumber])
  @@index([userId])
}

model ConsolidatedShipment {
  id                     String    @id @default(uuid())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  gmcShipmentNumber      String    @unique
  destinationCountryCode String?
  status                 String
  storagePaidUntil       DateTime?
  selectedCourier        String?
  courierService         String?
  finalTrackingNumber    String?
  shippingLabelUrl       String?
  paymentId              String?
  weightLbs              Float?
  subtotalAmount         Float?    @default(0.0)
  processingFee          Float?    @default(0.0)
  totalAmount            Float?
  widthIn                Float?
  heightIn               Float?
  lengthIn               Float?
  userId                 String
  customsItems           Json?
  declaredValue          Float?    @default(0.0)
  deliveredBy            String?
  serviceType            String    @default("CONSOLIDATION")
  shippingAddress        String?
  awbDocumentUrl         String?
  auraDetails            Json?
  extraCharges           Json?
  tenant_id              String?
  easypostRateId         String?
  easypostShipmentId     String?
  easypostTrackerId      String?
  lat                    Float?
  lng                    Float?
  chargeConsolidationFee Boolean   @default(false)
  tenant                 Tenant?   @relation(fields: [tenant_id], references: [id])
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  packages               Package[]

  @@index([gmcShipmentNumber])
  @@index([userId])
}

model PickupRequest {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  serviceType      String   @default("SHIPPING")
  originAddress    String
  originCity       String
  pickupDate       DateTime
  description      String
  contactPhone     String
  dropOffAddress   String?
  dropOffCity      String?
  dropOffContact   String?
  dropOffPhone     String?
  subtotal         Float?   @default(0.0)
  processingFee    Float?   @default(0.0)
  totalPaid        Float?   @default(0.0)
  stripePaymentId  String?
  weightInfo       String?
  volumeInfo       String?
  photoPickupUrl   String?
  photoDeliveryUrl String?
  status           String   @default("PENDIENTE")
  userId           String
  driverId         String?
  signatureUrl     String?
  tookanLink       String?
  tenant_id        String?
  weightLbs        Float?
  distanceMiles    Float?
  isPalletMode     Boolean  @default(false)
  extraStops       Json?
  lat              Float?
  lng              Float?
  latDest          Float?
  lngDest          Float?
  pickupPin        String?
  recipientName    String?
  driver           User?    @relation("DriverAssignments", fields: [driverId], references: [id])
  tenant           Tenant?  @relation(fields: [tenant_id], references: [id])
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  title     String
  message   String
  href      String?
  isRead    Boolean  @default(false)
  type      String   @default("INFO")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
}

model Address {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  fullName    String
  address     String
  cityZip     String
  country     String
  countryCode String?
  phone       String?
  isDefault   Boolean  @default(false)
  userId      String
  city        String?
  state       String?
  zip         String?
  county      String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MailboxSubscription {
  id                   String                @id @default(uuid())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  planType             String
  status               String                @default("PENDING_USPS")
  uspsForm1583Url      String?
  primaryIdUrl         String?
  secondaryIdUrl       String?
  rejectionReason      String?
  currentPeriodEnd     DateTime?
  stripeSubscriptionId String?               @unique
  userId               String                @unique
  tenant_id            String?
  additionalRecipients AdditionalRecipient[]
  tenant               Tenant?               @relation(fields: [tenant_id], references: [id])
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdditionalRecipient {
  id              String              @id @default(uuid())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  fullName        String
  email           String?
  uspsForm1583Url String?
  primaryIdUrl    String?
  secondaryIdUrl  String?
  status          String              @default("PENDING_USPS")
  rejectionReason String?
  subscriptionId  String
  subscription    MailboxSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model MailItem {
  id               String              @id @default(uuid())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  trackingNumber   String?             @unique
  senderName       String?
  weightOz         Float?
  lengthIn         Float?
  widthIn          Float?
  heightIn         Float?
  isDamaged        Boolean             @default(false)
  envelopeImageUrl String
  scannedDocUrl    String?
  status           String              @default("UNREAD")
  receivedAt       DateTime            @default(now())
  userId           String
  cargoPackageId   String?             @unique
  tenant_id        String?
  tenant           Tenant?             @relation(fields: [tenant_id], references: [id])
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  pickupRequests   MailPickupRequest[] @relation("MailItemToMailPickupRequest")
}

model MailboxTransaction {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  amount          Float
  description     String
  status          String   @default("COMPLETED")
  stripePaymentId String? @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShopperOrder {
  id               String        @id @default(cuid())
  userId           String
  status           String        @default("PENDING_QUOTE")
  itemsSubtotal    Float         @default(0)
  usTaxes          Float         @default(0)
  domesticShipping Float         @default(0)
  gmcShopperFee    Float         @default(0)
  stripeFee        Float         @default(0)
  totalAmount      Float         @default(0)
  stripePaymentId  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  serviceType      String        @default("PERSONAL_SHOPPER")
  tenant_id        String?
  items            ShopperItem[]
  tenant           Tenant?       @relation(fields: [tenant_id], references: [id])
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ShopperItem {
  id            String       @id @default(cuid())
  orderId       String
  storeName     String?
  productUrl    String
  name          String?
  details       String?
  quantity      Int          @default(1)
  declaredPrice Float
  actualPrice   Float?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  order         ShopperOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model MailPickupRequest {
  id            String     @id @default(cuid())
  userId        String
  scheduledDate DateTime
  scheduledTime String
  status        String     @default("PENDING")
  createdAt     DateTime   @default(now())
  completedAt   DateTime?
  tenant_id     String?
  tenant        Tenant?    @relation(fields: [tenant_id], references: [id])
  user          User       @relation(fields: [userId], references: [id])
  mailItems     MailItem[] @relation("MailItemToMailPickupRequest")
}

model AmazonProduct {
  id           String   @id @default(uuid())
  title        String
  price        String
  imageUrl     String
  affiliateUrl String
  category     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}

model Tenant {
  id                              String                 @id @default(uuid())
  company_name                    String
  slug                            String                 @unique
  custom_domain                   String?                @unique
  logo_url                        String?
  primary_color                   String                 @default("#000000")
  secondary_color                 String                 @default("#ffffff")
  owner_name                      String?
  owner_email                     String                 @unique
  owner_phone                     String?
  easypost_api_key                String?
  stripe_publishable_key          String?
  stripe_secret_key               String?
  created_at                      DateTime               @default(now())
  updated_at                      DateTime               @updatedAt
  stripe_mailbox_basic_price_id   String?
  stripe_mailbox_premium_price_id String?
  twilio_account_sid              String?
  twilio_auth_token               String?
  twilio_messaging_service_sid    String?
  twilio_phone_number             String?
  consolidatedShipments           ConsolidatedShipment[]
  mailItems                       MailItem[]
  mailPickupRequests              MailPickupRequest[]
  mailboxSubscriptions            MailboxSubscription[]
  packages                        Package[]
  pickupRequests                  PickupRequest[]
  shopperOrders                   ShopperOrder[]
  users                           User[]
  tenantPlan                      TenantPlan?
  tenantRates                     TenantRate[]

  @@map("tenants")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TenantPlan {
  id           String    @id @default(uuid())
  tenantId     String    @unique @map("tenant_id")
  plan         String    @default("starter")
  status       String    @default("trial")
  setupPaid    Boolean   @default(false) @map("setup_paid")
  billingStart DateTime? @map("billing_start") @db.Date
  nextBilling  DateTime? @map("next_billing") @db.Date
  monthlyPrice Int       @default(14900) @map("monthly_price")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_plans")
}

model TenantRate {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  concept     String
  value       Decimal  @db.Decimal(10, 4)
  countryCode String?  @map("country_code")
  updatedAt   DateTime @updatedAt @map("updated_at")
  textValue   String?  @map("text_value")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, concept, countryCode])
  @@map("tenant_rates")
}

model Lead {
  id           String    @id @default(uuid())
  lead_id      String    @unique
  full_name    String?
  phone_number String?
  email        String?
  form_id      String?
  source       String?   @default("facebook")
  created_time DateTime?
  created_at   DateTime  @default(now())
  contacted_at DateTime?
  notes        String?
  status       String?   @default("new")

  @@map("Lead")
}

model DriverSession {
  id        String   @id @default(uuid())
  driverId  String   @unique
  isOnline  Boolean  @default(false)
  lastSeen  DateTime @default(now())
  lat       Float?
  lng       Float?
  heading   Float?
  speed     Float?
  deviceId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pushToken String?
  driver    User     @relation("DriverSession", fields: [driverId], references: [id], onDelete: Cascade)

  @@index([isOnline])
  @@map("driver_sessions")
}

model DriverVehicle {
  id                   String    @id @default(uuid())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  driverId             String
  type                 String
  make                 String
  model                String
  year                 Int
  color                String
  licensePlate         String
  vehiclePhotoUrl      String?
  insuranceUrl         String?
  driverLicenseUrl     String?
  isVerified           Boolean   @default(false)
  verifiedAt           DateTime?
  rejectionReason      String?
  status               String    @default("PENDING")
  driverLicenseBackUrl String?
  isActive             Boolean   @default(false)
  driver               User      @relation("DriverVehicle", fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_vehicles")
}

model DriverApplication {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  name         String
  email        String
  phone        String
  zone         String
  vehicleType  String
  hasInsurance String?
  message      String?
  status       String   @default("PENDING")
  notes        String?

  @@map("driver_applications")
}

model B2BAccount {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  userId          String    @unique
  businessName    String
  businessAddress String
  businessPhone   String?
  contactName     String?
  creditLimit     Float     @default(500)
  creditUsed      Float     @default(0)
  billingCycle    Int       @default(30)
  nextBillingDate DateTime?
  autoPayEnabled  Boolean   @default(false)
  status          String    @default("ACTIVE")
  logoUrl         String?
  user            User      @relation(fields: [userId], references: [id])
}

model LockerConfig {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  key       String   @unique
  value     String
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("locker_config")
}

model SmsOtp {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  phone     String
  code      String
  userId    String?  @map("user_id")
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone], map: "idx_sms_otp_phone")
  @@index([userId], map: "idx_sms_otp_user_id")
  @@map("sms_otp")
}
